# Copy to .env.local; use a dedicated Supabase Free TEST project in Singapore.
# Disable Confirm email only in this test project. No real business data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Two DIFFERENT existing test accounts. Register them through the app first.
# Test credentials stay local and must never be configured as NEXT_PUBLIC_*.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=

# Browser test target. Blank starts an isolated local server on port 3100.
TEST_BASE_URL=
# Reuse installed Chrome by default; msedge also works. chromium requires download.
PLAYWRIGHT_CHANNEL=chrome
# Only for testing a protected Vercel deployment. Never commit this secret.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional: Supabase CLI only, never needed by the running website.
# Set these in a private terminal session when linking/applying migrations.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
